{
  "expo": {
    "name": "CMPort Técnico",
    "slug": "cmport-tecnico",
    "scheme": [
      "cmporttecnico",
      "cmportos"
    ],
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "br.com.cmport.tecnico",
      "adaptiveIcon": {
        "backgroundColor": "#EEF2F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-build-properties",
      "@config-plugins/react-native-webrtc",
      "expo-font",
      "expo-video",
      "expo-sharing",
      "expo-asset",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "O CM Port salva na galeria as gravações que você baixar.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O CM Port usa as suas fotos só para a foto do perfil e para anexar ao serviço.",
          "cameraPermission": "O CM Port usa a câmera para as fotos do serviço (antes e depois)."
        }
      ],
      "expo-screen-orientation",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CM Port registra onde você estava ao chegar e ao concluir cada OS. Só com o app aberto."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O CM Port usa a câmera para as fotos do serviço e para ler o QR das etiquetas.",
          "microphonePermission": "O CM Port usa o microfone só quando você toca em gravar um áudio na OS."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0C0E12",
          "defaultChannel": "os"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O CM Port grava o áudio que você manda na OS (relato ou recado ao escritório). Só quando você toca em gravar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cd7a90b-193f-4c3f-907a-a7d40c5b7627"
      }
    },
    "owner": "biel.pedretti"
  }
}
